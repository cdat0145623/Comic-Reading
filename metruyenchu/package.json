{
    "name": "metruyenchu",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "aliases": {
        "@": "."
    },
    "scripts": {
        "dev": "next dev",
        "build": "npm run generate --workspace @mtc/database && next build",
        "start": "next start",
        "lint": "next lint",
        "test": "vitest",
        "test:run": "vitest run",
        "seed:catalog": "node prisma/seed-story-catalog.js",
        "cleanup:catalog": "node prisma/cleanup-story-catalog.js",
        "test:catalog:db": "RUN_DB_INTEGRATION=1 vitest run tests/catalog/story-catalog-service.integration.test.js",
        "test:admin-auth:db": "RUN_DB_INTEGRATION=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/auth/admin-credentials.integration.test.js"
    },
    "prisma": {
        "seed": "node prisma/createRating.js"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.9.1",
        "@mtc/auth": "*",
        "@mtc/database": "*",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.4.0",
        "@tanstack/react-query": "^5.83.0",
        "@tanstack/react-query-devtools": "^5.84.0",
        "bcryptjs": "^3.0.2",
        "cloudinary": "^2.9.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "esm-module-alias": "^2.2.1",
        "framer-motion": "^12.18.1",
        "lorem-ipsum": "^2.0.8",
        "nanoid": "^5.1.5",
        "next": "15.5.21",
        "next-auth": "5.0.0-beta.32",
        "next-cloudinary": "^6.17.5",
        "node-cron": "^4.1.0",
        "nodemailer": "^6.10.1",
        "p-limit": "^6.2.0",
        "postcss": "^8.5.3",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.58.1",
        "slugify": "^1.6.6",
        "sonner": "^2.0.5",
        "swiper": "^11.2.8",
        "uuid": "^11.1.0",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@tailwindcss/postcss": "^4.1.6",
        "eslint": "^9",
        "eslint-config-next": "15.5.21",
        "prisma": "6.19.3",
        "tailwindcss": "^4.1.6",
        "vitest": "^3.2.7"
    }
}
