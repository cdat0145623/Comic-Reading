{
    "name": "metruyenchu-workspace",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "metruyenchu",
        "admin",
        "packages/*",
        "workers/*"
    ],
    "scripts": {
        "dev:web": "npm run dev --workspace metruyenchu --",
        "dev:admin": "npm run dev --workspace metruyenchu-admin --",
        "dev:import-worker": "node --env-file=metruyenchu/.env workers/importer/index.js",
        "build:web": "npm run build --workspace metruyenchu",
        "build:admin": "npm run build --workspace metruyenchu-admin",
        "build": "npm run build:web && npm run build:admin",
        "lint": "npm run lint --workspace metruyenchu-admin",
        "test": "npm run test:run --workspace metruyenchu",
        "test:importer": "npm run test --workspace @mtc/importer",
        "test:importer:db": "RUN_DB_INTEGRATION=1 node --env-file=metruyenchu/.env --test packages/importer/tests/source.integration.test.js",
        "test:importer:queue-db": "RUN_DB_INTEGRATION=1 node --env-file=metruyenchu/.env --test packages/importer/tests/queue.integration.test.js",
        "benchmark:prepare": "node --env-file=metruyenchu/.env benchmarks/query-performance/prepare-user.mjs",
        "benchmark:smoke": "BENCHMARK_RUNS=2 node --env-file=metruyenchu/.env benchmarks/query-performance/run.mjs",
        "benchmark:query": "node --env-file=metruyenchu/.env benchmarks/query-performance/run.mjs",
        "benchmark:bookmark-delay:smoke": "BENCHMARK_RUNS=2 node --env-file=metruyenchu/.env benchmarks/query-performance/bookmark-delay-matrix.mjs",
        "benchmark:bookmark-delay": "node --env-file=metruyenchu/.env benchmarks/query-performance/bookmark-delay-matrix.mjs",
        "benchmark:chapter-navigation:smoke": "BENCHMARK_RUNS=2 BENCHMARK_WARMUPS=1 BENCHMARK_CHAPTER_DELAYS_MS=0,800 node --env-file=metruyenchu/.env benchmarks/query-performance/chapter-navigation.mjs",
        "benchmark:chapter-navigation": "node --env-file=metruyenchu/.env benchmarks/query-performance/chapter-navigation.mjs",
        "postinstall": "npm run db:generate",
        "db:generate": "npm run generate --workspace @mtc/database",
        "db:studio": "node --env-file=metruyenchu/.env ./node_modules/prisma/build/index.js studio --schema packages/database/prisma/schema.prisma",
        "db:migrate:dev": "node --env-file=metruyenchu/.env ./node_modules/prisma/build/index.js migrate dev --schema packages/database/prisma/schema.prisma",
        "db:migrate:deploy": "node --env-file=metruyenchu/.env ./node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
        "redis:up": "docker compose up -d redis",
        "redis:down": "docker compose down",
        "user:set-role": "node packages/auth/scripts/set-user-role.mjs"
    },
    "devDependencies": {
        "@prisma/client": "6.19.3",
        "prisma": "6.19.3"
    }
}
